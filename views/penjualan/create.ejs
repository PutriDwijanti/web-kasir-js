<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tambah Penjualan</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'" onerror="this.onerror=null;this.href='/path/to/local/fontawesome.css'">
</head>

<body class="bg-gray-100 p-6">

<div class="max-w-4xl mx-auto bg-white p-6 rounded-xl shadow">

  <h1 class="text-2xl font-bold mb-5">Tambah Penjualan</h1>

  <!-- PELANGGAN -->
  <label class="block mb-1">Pelanggan</label>
  <select id="pelanggan" class="w-full p-2 border rounded mb-3">
    <option value="">-- Pilih Pelanggan --</option>
  </select>

  <!-- TANGGAL -->
  <label class="block mb-1">Tanggal</label>
  <input type="date" id="tanggal" class="w-full p-2 border rounded mb-4">

  <hr class="my-4">

  <!-- PRODUK -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-3">
    <select id="produk" class="p-2 border rounded col-span-2"></select>
    <input type="number" id="jumlah" value="1" min="1" class="p-2 border rounded">
  </div>

  <button id="add" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
    + Tambah Produk
  </button>

  <!-- TABLE -->
  <div class="mt-6 overflow-x-auto">
    <table class="w-full border text-sm">
      <thead class="bg-gray-200">
        <tr>
          <th class="p-2">Produk</th>
          <th>Harga</th>
          <th>Qty</th>
          <th>Subtotal</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody id="cart"></tbody>
    </table>
  </div>

  <!-- TOTAL -->
  <div class="mt-4 text-lg font-bold">
    Total: <span id="total">Rp 0</span>
  </div>

  <!-- BAYAR -->
<div class="mt-4">
  <label class="block mb-1">Bayar</label>

  <div class="flex items-center border rounded overflow-hidden">
    <span class="bg-gray-200 px-3 py-2 text-gray-700">Rp</span>
    <input id="bayar" type="number" class="w-full p-2 outline-none">
  </div>
</div>

  <!-- KEMBALIAN -->
  <div class="mt-2 text-lg font-bold">
    Kembalian: <span id="kembalian">Rp 0</span>
  </div>

  <!-- BUTTON -->
  <div class="mt-5 space-y-2">

    <!-- SIMPAN -->
    <button id="save"
      class="w-full bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 flex items-center justify-center gap-2">

      <i class="fa-solid fa-floppy-disk"></i>
      Simpan Penjualan
    </button>

    <!-- KEMBALI -->
    <a href="/penjualan"
      class="w-full block text-center bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600">
      ← Kembali ke Index
    </a>

  </div>

</div>

<script>
let cart = [];

const cartEl = document.getElementById("cart");
const totalEl = document.getElementById("total");
const bayarEl = document.getElementById("bayar");
const kembalianEl = document.getElementById("kembalian");


// FIX RUPIAH + 000
function format(n){
  return "Rp " + (Number(n) * 1000).toLocaleString("id-ID");
}


// TOTAL
function total(){
  return cart.reduce((a,b)=>a + (b.harga * b.qty),0);
}


// RENDER CART
function render(){
  cartEl.innerHTML = "";

  cart.forEach((item,i)=>{
    cartEl.innerHTML += `
      <tr class="border-t">
        <td class="p-2">${item.nama}</td>
        <td class="p-2">${format(item.harga)}</td>
        <td class="p-2">${item.qty}</td>
        <td class="p-2">${format(item.harga * item.qty)}</td>
        <td class="p-2">
          <button onclick="hapus(${i})" class="bg-red-500 text-white px-2 py-1 rounded">
            Hapus
          </button>
        </td>
      </tr>
    `;
  });

  const t = total();
  totalEl.innerText = format(t);

  const bayar = Number(bayarEl.value || 0);
  kembalianEl.innerText = format(bayar - t);
}


// HAPUS ITEM
function hapus(i){
  cart.splice(i,1);
  render();
}


// TAMBAH PRODUK
document.getElementById("add").onclick = ()=>{
  const p = document.getElementById("produk");

  if(!p.value) return alert("Pilih produk dulu");

  const nama = p.options[p.selectedIndex].text.split(" - ")[0];
  const harga = Number(p.options[p.selectedIndex].dataset.harga);
  const id = p.value;
  const qty = Number(document.getElementById("jumlah").value);

  const exist = cart.find(x=>x.id == id);

  if(exist){
    exist.qty += qty;
  } else {
    cart.push({id,nama,harga,qty});
  }

  render();
};


// BAYAR REALTIME
bayarEl.addEventListener("input", render);


// LOAD PRODUK
async function loadProduk(){
  const res = await fetch("/api/produk");
  const data = await res.json();

  const select = document.getElementById("produk");

  data.forEach(p=>{
    const opt = document.createElement("option");
    opt.value = p.produkid;
    opt.dataset.harga = p.harga;
    opt.textContent = `${p.namaproduk} - Rp ${(p.harga * 1000).toLocaleString("id-ID")}`;
    select.appendChild(opt);
  });
}


// LOAD PELANGGAN
async function loadPelanggan(){
  const res = await fetch("/api/pelanggan");
  const data = await res.json();

  const select = document.getElementById("pelanggan");

  data.forEach(p=>{
    const opt = document.createElement("option");
    opt.value = p.pelangganid;
    opt.textContent = p.namapelanggan;
    select.appendChild(opt);
  });
}


// SIMPAN
document.getElementById("save").onclick = async () => {

  const pelangganid = document.getElementById("pelanggan").value;
  const tanggal = document.getElementById("tanggal").value;

  const t = total();
  const bayar = Number(bayarEl.value);

  if (cart.length === 0) {
    alert("Keranjang kosong");
    return;
  }

  if (bayar < t) {
    alert("Uang kurang!");
    return;
  }

  // 🔥 INI YANG KAMU TANYA → TARUH DI SINI
  const data = {
    pelangganid: Number(pelangganid),
    tanggalpenjualan: tanggal,

    items: cart.map(i => ({
      produkid: Number(i.id),
      qty: i.qty,
      hargasatuan: i.harga * 1000
    })),

    bayar: bayar * 1000,
    kembalian: (bayar - t) * 1000
  };

  const res = await fetch("/penjualan", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data)
  });

  if (res.ok) {
    alert("Penjualan berhasil!");
    location.href = "/penjualan";
  } else {
    alert("Gagal simpan");
  }
};

loadProduk();
loadPelanggan();

</script>

</body>
</html>