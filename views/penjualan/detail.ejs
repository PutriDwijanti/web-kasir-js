<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Detail Penjualan</title>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body class="bg-gray-100 p-6">

<div class="max-w-5xl mx-auto bg-white p-6 rounded-xl shadow">

  <!-- TITLE -->
  <h1 class="text-2xl font-bold mb-6">Detail Penjualan</h1>

  <!-- INFO HEADER -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">

    <div class="border rounded-lg p-4 bg-gray-50">
      <p class="mb-2"><span class="font-semibold">ID Penjualan:</span> <%= penjualan.penjualanid %></p>
      <p><span class="font-semibold">Nama Pelanggan:</span> <%= penjualan.namapelanggan %></p>
    </div>

    <div class="border rounded-lg p-4 bg-gray-50">
      <p>
        <span class="font-semibold">Tanggal:</span>
        <% if (penjualan.tanggalpenjualan) { %>
          <%= new Date(penjualan.tanggalpenjualan).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
          }) %>
        <% } else { %>
          -
        <% } %>
      </p>
    </div>

  </div>

  <!-- TABLE -->
  <div class="overflow-x-auto">
    <table class="w-full border text-sm">
      <thead class="bg-blue-500 text-white">
        <tr>
          <th class="p-2">ID Produk</th>
          <th class="p-2">Nama Produk</th>
          <th class="p-2">Qty</th>
          <th class="p-2">Harga</th>
          <th class="p-2">Subtotal</th>
        </tr>
      </thead>

      <tbody>
        <% if (penjualan.items && penjualan.items.length > 0) { %>
          <% penjualan.items.forEach(item => { %>
            <tr class="border-t hover:bg-gray-50">
              <td class="p-2"><%= item.produkid %></td>
              <td class="p-2"><%= item.namaproduk %></td>
              <td class="p-2"><%= item.qty %></td>
              <td class="p-2">
                Rp <%= Number(item.hargasatuan).toLocaleString('id-ID') %>
              </td>
              <td class="p-2 font-semibold">
                Rp <%= Number(item.subtotal).toLocaleString('id-ID') %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center p-4 text-gray-500">
              Tidak ada data produk
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- SUMMARY BOX -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- TOTAL -->
    <div class="p-4 border rounded-lg bg-gray-50 text-center">
      <p class="text-gray-500">Total</p>
      <p class="text-xl font-bold">
        Rp <%= Number(penjualan.totalharga || 0).toLocaleString('id-ID') %>
      </p>
    </div>

    <!-- BAYAR -->
    <div class="p-4 border rounded-lg bg-gray-50 text-center">
      <p class="text-gray-500">Bayar</p>
      <p class="text-xl font-bold text-blue-600">
        Rp <%= Number(penjualan.bayar || 0).toLocaleString('id-ID') %>
      </p>
    </div>

    <!-- KEMBALIAN -->
    <div class="p-4 border rounded-lg bg-gray-50 text-center">
      <p class="text-gray-500">Kembalian</p>
      <p class="text-xl font-bold text-green-600">
        Rp <%= Number(penjualan.kembalian || 0).toLocaleString('id-ID') %>
      </p>
    </div>

  </div>

  <!-- BACK BUTTON -->
  <div class="mt-6">
    <a href="/penjualan"
       class="inline-flex items-center gap-2 bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600">
      <i class="fa-solid fa-arrow-left"></i>
      Kembali ke Daftar Penjualan
    </a>
  </div>

</div>

</body>
</html>