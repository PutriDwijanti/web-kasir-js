<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100 text-gray-900">

<div class="flex min-h-screen">

  <!-- OVERLAY MOBILE -->
  <div id="overlay" class="fixed inset-0 bg-black/50 hidden md:hidden z-40"></div>

  <!-- SIDEBAR -->
  <aside id="sidebar"
    class="w-64 bg-white shadow-lg fixed md:relative top-0 left-0 h-screen transform -translate-x-full md:translate-x-0 transition duration-300 z-50">

    <div class="p-5 text-xl font-bold border-b">
      💰 KASIRKU
    </div>

    <nav class="flex flex-col p-4 gap-3">
      <a href="/dashboard" class="bg-blue-600 text-white px-4 py-2 rounded">
        <i class="fas fa-home"></i> Dashboard
      </a>

      <a href="/pelanggan" class="hover:bg-gray-200 px-4 py-2 rounded">
        <i class="fas fa-user"></i> Pelanggan
      </a>

      <a href="/produk" class="hover:bg-gray-200 px-4 py-2 rounded">
        <i class="fas fa-box"></i> Produk
      </a>

      <a href="/penjualan" class="hover:bg-gray-200 px-4 py-2 rounded">
        <i class="fas fa-receipt"></i> Penjualan
      </a>
    </nav>
  </aside>

  <!-- MAIN -->
  <div class="flex-1">

    <!-- HEADER -->
    <div class="flex justify-between items-center bg-white shadow px-6 py-4">

      <div class="flex items-center gap-3">
        <button id="hamburger" class="md:hidden text-xl">
          <i class="fas fa-bars"></i>
        </button>
        <h1 class="text-xl font-bold">Dashboard</h1>
      </div>

    </div>

    <!-- CONTENT -->
    <div class="p-6">

      <!-- CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">

        <div class="bg-white p-5 rounded-xl shadow">
          <h2 class="text-gray-500">Total Produk</h2>
          <p class="text-2xl font-bold text-blue-600"><%= totalProduk %></p>
        </div>

        <div class="bg-white p-5 rounded-xl shadow">
          <h2 class="text-gray-500">Total Pelanggan</h2>
          <p class="text-2xl font-bold text-green-600"><%= totalPelanggan %></p>
        </div>

        <div class="bg-white p-5 rounded-xl shadow">
          <h2 class="text-gray-500">Total Penjualan</h2>
          <p class="text-2xl font-bold text-purple-600"><%= totalPenjualan %></p>
        </div>

      </div>

      <!-- SEARCH -->
      <div class="mb-4">
        <input 
          type="text" 
          id="searchInput"
          placeholder="Cari pelanggan..."
          class="border p-2 rounded w-full md:w-1/3"
        >
      </div>

      <!-- TABLE -->
      <div class="overflow-x-auto bg-white rounded-lg shadow">

        <table class="w-full">
          <thead class="bg-blue-600 text-white">
            <tr>
              <th class="p-3">ID</th>
              <th class="p-3">Tanggal</th>
              <th class="p-3">Pelanggan</th>
              <th class="p-3">Total</th>
              <th class="p-3">Aksi</th>
            </tr>
          </thead>

          <tbody id="penjualanTable">
            <% (penjualanTerbaru || []).forEach(item => { %>
              <tr class="text-center border-b hover:bg-gray-100">

                <td class="p-2"><%= item.penjualanid %></td>

                <td class="p-2">
                  <%= item.tanggalpenjualan
                    ? new Date(item.tanggalpenjualan).toLocaleDateString('id-ID')
                    : '-' %>
                </td>

                <td class="p-2"><%= item.namapelanggan || '-' %></td>

                <td class="p-2">
                  <%= new Intl.NumberFormat('id-ID', {
                  style: 'currency',
                  currency: 'IDR',
                  minimumFractionDigits: 0
                  }).format((item.totalharga || 0) * 1000) %>
                </td>

                <td class="p-2">
                  <a href="/penjualan/detail/<%= item.penjualanid %>"
                     class="bg-cyan-500 text-white px-3 py-1 rounded hover:bg-cyan-600">
                    <i class="fas fa-eye"></i>
                  </a>
                </td>

              </tr>
            <% }) %>
          </tbody>

        </table>
      </div>

    </div>
  </div>
</div>

<!-- SCRIPT -->
<script>
  // SIDEBAR MOBILE
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('overlay');
  const hamburger = document.getElementById('hamburger');

  hamburger.addEventListener('click', () => {
    sidebar.classList.toggle('-translate-x-full');
    overlay.classList.toggle('hidden');
  });

  overlay.addEventListener('click', () => {
    sidebar.classList.add('-translate-x-full');
    overlay.classList.add('hidden');
  });

  // SEARCH
  document.getElementById('searchInput').addEventListener('input', function() {
    const filter = this.value.toLowerCase();
    const rows = document.querySelectorAll('#penjualanTable tr');

    rows.forEach(row => {
      const nama = row.cells[2].textContent.toLowerCase();
      row.style.display = nama.includes(filter) ? '' : 'none';
    });
  });
</script>

</body>
</html>