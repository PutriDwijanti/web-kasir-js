<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tambah Produk</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

  <!-- WRAPPER -->
  <div class="min-h-screen flex items-center justify-center px-4">

    <!-- CARD -->
    <div class="w-full max-w-md bg-white shadow-xl rounded-2xl p-6 md:p-8">

      <!-- HEADER -->
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-gray-800">Tambah Produk</h1>
      </div>

      <!-- FORM -->
      <form action="/produk/create" method="POST" id="createForm" class="space-y-5" enctype="multipart/form-data">

        <!-- Nama -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Produk</label>
          <input type="text" name="namaproduk"
            class="w-full px-3 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
          <p id="namaError" class="text-red-500 text-xs mt-1 hidden">Nama tidak boleh kosong</p>
        </div>

        <!-- Harga -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Harga</label>
          <input type="number" name="harga" step="0.01"
            class="w-full px-3 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
          <p id="hargaError" class="text-red-500 text-xs mt-1 hidden">Harga harus > 0</p>
        </div>

        <!-- Stok -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Stok</label>
          <input type="number" name="stok"
            class="w-full px-3 py-3 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
          <p id="stokError" class="text-red-500 text-xs mt-1 hidden">Stok tidak valid</p>
        </div>
        <!-- GAMBAR -->
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">
          Gambar Produk
        </label>

        <input type="file" name="gambar" accept="image/*"
          class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
          <img id="preview" class="hidden w-32 mt-2 rounded-lg border" />

        <p class="text-xs text-gray-400 mt-1">
          Upload gambar produk (jpg, png, dll)
        </p>
      </div>

        <!-- BUTTON -->
        <button type="submit"
          class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg flex items-center justify-center gap-2 font-medium shadow">
          <i class="fas fa-save"></i> Simpan
        </button>

      </form>

      <!-- BACK -->
      <a href="/produk"
        class="mt-4 block text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg font-medium shadow">
        <i class="fas fa-arrow-left"></i> Kembali
      </a>

    </div>
  </div>

  <!-- SCRIPT VALIDATION -->
  <script>
    const form = document.getElementById('createForm');

    form.addEventListener('submit', (e) => {
      const nama = form.namaproduk.value.trim();
      const harga = parseFloat(form.harga.value);
      const stok = parseInt(form.stok.value);

      let valid = true;

      document.querySelectorAll('p[id$="Error"]').forEach(el => el.classList.add('hidden'));

      if (!nama) {
        document.getElementById('namaError').classList.remove('hidden');
        valid = false;
      }

      if (isNaN(harga) || harga <= 0) {
        document.getElementById('hargaError').classList.remove('hidden');
        valid = false;
      }

      if (isNaN(stok) || stok < 0) {
        document.getElementById('stokError').classList.remove('hidden');
        valid = false;
      }

      if (!valid) e.preventDefault();
    });
  </script>
  <script>
const inputGambar = document.querySelector('input[name="gambar"]');
const preview = document.getElementById('preview');

inputGambar.addEventListener('change', function () {
  const file = this.files[0];

  if (file) {
    preview.src = URL.createObjectURL(file);
    preview.classList.remove('hidden');
  }
});
</script>

</body>
</html>