<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Produk</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="min-h-screen flex items-center justify-center px-4 py-8">

  <!-- CARD -->
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-xl p-6 sm:p-8">

    <!-- HEADER -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">
        Detail Produk
      </h1>
    </div>

    <!-- CONTENT -->
    <div class="space-y-5 text-gray-700 text-base sm:text-lg">

      <div class="flex justify-between border-b pb-3">
        <span class="font-semibold">ID Produk</span>
        <span><%= produk.produkid %></span>
      </div>

      <div class="flex justify-between border-b pb-3 items-start">
        <span class="font-semibold">Nama Produk</span>
        <span class="text-right max-w-[60%] break-words">
          <%= produk.namaproduk %>
        </span>
      </div>

      <div class="flex justify-between border-b pb-3">
        <span class="font-semibold">Harga</span>
        <span class="text-green-600 font-bold text-lg">
         Rp <%= (Number(produk.harga) * 1000).toLocaleString('id-ID') %>
        </span>
      </div>

      <div class="flex justify-between">
        <span class="font-semibold">Stok</span>
        <span class="text-blue-600 font-bold text-lg">
          <%= produk.stok %>
        </span>
      </div>
      <!-- GAMBAR PRODUK -->
      <div class="flex justify-center mb-6">
        <% if (produk.gambar) { %>
          <img 
            src="/uploads/<%= produk.gambar %>" 
            alt="Gambar Produk"
            class="w-48 h-48 object-cover rounded-xl shadow border"
          >
        <% } else { %>
          <div class="w-48 h-48 bg-gray-200 rounded-xl flex items-center justify-center text-gray-500">
            Tidak ada gambar
          </div>
        <% } %>
      </div>

    </div>

    <!-- BUTTON -->
    <a href="/produk"
      class="mt-8 block text-center bg-cyan-500 hover:bg-cyan-600 text-white py-3 rounded-xl text-base sm:text-lg transition">
      <i class="fas fa-arrow-left"></i> Kembali
    </a>

  </div>

</div>

</body>
</html>