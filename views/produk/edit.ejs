<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Produk</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

<div class="min-h-screen flex items-center justify-center px-4 py-6">

  <div class="w-full max-w-md sm:max-w-lg bg-white rounded-xl shadow-lg p-5 sm:p-6">

    <!-- Header -->
    <div class="mb-6 text-center sm:text-left">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-800">
        Edit Produk
      </h1>
    </div>

    <!-- Form -->
    <form action="/produk/edit/<%= produk.produkid %>" method="POST" id="editForm" class="space-y-4">

      <!-- ID -->
      <div>
        <label class="block text-sm font-medium text-gray-700">ID Produk</label>
        <input type="text" name="txtid"
          value="<%= produk.produkid %>"
          readonly
          class="w-full mt-1 px-3 py-2 rounded-lg bg-gray-200 text-gray-600 cursor-not-allowed">
      </div>

      <!-- Nama -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Nama Produk</label>
        <input type="text" name="namaproduk"
          value="<%= produk.namaproduk %>"
          class="w-full mt-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
        <p class="text-red-500 text-xs mt-1 hidden" id="namaError">Nama tidak boleh kosong</p>
      </div>

      <!-- Harga -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Harga</label>
        <input type="number" name="harga"
          value="<%= produk.harga %>"
          class="w-full mt-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
        <p class="text-red-500 text-xs mt-1 hidden" id="hargaError">Harga harus > 0</p>
      </div>

      <!-- Stok -->
      <div>
        <label class="block text-sm font-medium text-gray-700">Stok</label>
        <input type="number" name="stok"
          value="<%= produk.stok %>"
          class="w-full mt-1 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-blue-400 outline-none">
        <p class="text-red-500 text-xs mt-1 hidden" id="stokError">Stok tidak valid</p>
      </div>

      <!-- Button -->
      <button type="submit"
        class="w-full bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg flex items-center justify-center gap-2 transition">
        <i class="fas fa-save"></i>
        Update
      </button>

    </form>

    <!-- Back -->
    <a href="/produk"
      class="mt-4 block text-center bg-cyan-500 hover:bg-cyan-600 text-white py-2 rounded-lg transition">
      <i class="fas fa-arrow-left"></i> Kembali
    </a>

  </div>

</div>

<script>
// Validation
const form = document.getElementById('editForm');

form.addEventListener('submit', (e) => {
  let valid = true;

  const nama = form.namaproduk.value.trim();
  const harga = parseFloat(form.harga.value);
  const stok = parseInt(form.stok.value);

  document.querySelectorAll('p[id$="Error"]').forEach(el => el.classList.add('hidden'));

  if (!nama) {
    document.getElementById('namaError').classList.remove('hidden');
    valid = false;
  }

  if (isNaN(harga) || harga <= 0) {
    document.getElementById('hargaError').classList.remove('hidden');
    valid = false;
  }

  if (isNaN(stok) || stok < 0) {
    document.getElementById('stokError').classList.remove('hidden');
    valid = false;
  }

  if (!valid) e.preventDefault();
});
</script>

</body>
</html>