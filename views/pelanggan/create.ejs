<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tambah Pelanggan</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

  <!-- CONTAINER -->
  <div class="min-h-screen flex items-center justify-center px-4 py-10">

    <div class="w-full max-w-md bg-white p-6 md:p-8 rounded-xl shadow">

      <!-- HEADER -->
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-gray-800">
          Tambah Pelanggan
        </h1>
        <p class="text-sm text-gray-500">Isi data dengan benar</p>
      </div>

      <!-- FORM -->
      <form action="/pelanggan" method="POST" id="createForm" class="space-y-4">

        <!-- Nama -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Nama</label>
          <input type="text" name="namapelanggan"
            class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-blue-500">
          <p class="text-red-500 text-xs mt-1 hidden" id="namaError">Nama tidak boleh kosong</p>
        </div>

        <!-- Alamat -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Alamat</label>
          <textarea name="alamat"
            class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
          <p class="text-red-500 text-xs mt-1 hidden" id="alamatError">Alamat tidak boleh kosong</p>
        </div>

        <!-- Telepon -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Telepon</label>
          <input type="text" name="nomortelepon"
            class="w-full mt-1 p-2 border rounded focus:ring-2 focus:ring-blue-500">
          <p class="text-red-500 text-xs mt-1 hidden" id="teleponError">Telepon tidak valid</p>
        </div>

        <!-- BUTTON -->
        <button type="submit"
          class="w-full bg-green-600 hover:bg-green-700 text-white py-2 rounded flex items-center justify-center gap-2">
          <i class="fas fa-save"></i> Simpan
        </button>

      </form>

      <!-- BACK -->
      <a href="/pelanggan"
        class="block text-center mt-4 bg-cyan-600 hover:bg-cyan-700 text-white py-2 rounded">
        <i class="fas fa-arrow-left"></i> Kembali
      </a>

    </div>
  </div>

  <script>
    const form = document.getElementById('createForm');

    form.addEventListener('submit', (e) => {
      const nama = form.namapelanggan.value.trim();
      const alamat = form.alamat.value.trim();
      const telepon = form.nomortelepon.value.trim();
      const regex = /^[0-9+\-\s]{10,15}$/;

      let valid = true;

      document.querySelectorAll('p[id$="Error"]').forEach(el => el.classList.add('hidden'));

      if (!nama) {
        document.getElementById('namaError').classList.remove('hidden');
        valid = false;
      }

      if (!alamat) {
        document.getElementById('alamatError').classList.remove('hidden');
        valid = false;
      }

      if (!telepon || !regex.test(telepon)) {
        document.getElementById('teleponError').classList.remove('hidden');
        valid = false;
      }

      if (!valid) e.preventDefault();
    });
  </script>

</body>
</html>