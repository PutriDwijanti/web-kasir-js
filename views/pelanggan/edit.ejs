<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Pelanggan</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

  <!-- WRAPPER -->
  <div class="min-h-screen flex items-center justify-center px-4">

    <!-- CARD -->
    <div class="w-full max-w-lg bg-white shadow-xl rounded-2xl p-6 md:p-8">

      <!-- HEADER -->
      <div class="mb-6 text-center">
        <h1 class="text-2xl font-bold text-gray-800">
          Edit Pelanggan
        </h1>
      </div>

      <!-- FORM -->
      <form action="/pelanggan/<%= pelanggan.pelangganid %>/edit" method="POST" id="editForm" class="space-y-5">

        <!-- Nama -->
        <div>
          <label class="block text-sm font-semibold text-gray-700">Nama</label>
          <input type="text" name="namapelanggan"
            value="<%= pelanggan.namapelanggan %>"
            class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-blue-500">
          <p id="namaError" class="text-red-500 text-xs mt-1 hidden">Nama tidak boleh kosong</p>
        </div>

        <!-- Alamat -->
        <div>
          <label class="block text-sm font-semibold text-gray-700">Alamat</label>
          <textarea name="alamat"
            class="w-full mt-1 p-3 border rounded-lg resize-none focus:ring-2 focus:ring-blue-500 h-24"><%= pelanggan.alamat %></textarea>
          <p id="alamatError" class="text-red-500 text-xs mt-1 hidden">Alamat tidak boleh kosong</p>
        </div>

        <!-- Telepon -->
        <div>
          <label class="block text-sm font-semibold text-gray-700">Telepon</label>
          <input type="text" name="nomortelepon"
            value="<%= pelanggan.nomortelepon %>"
            class="w-full mt-1 p-3 border rounded-lg focus:ring-2 focus:ring-blue-500">
          <p id="teleponError" class="text-red-500 text-xs mt-1 hidden">Telepon tidak boleh kosong</p>
        </div>

        <!-- BUTTON -->
        <button type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-lg flex justify-center items-center gap-2 font-medium">
          <i class="fas fa-save"></i> Update
        </button>

      </form>

      <!-- BACK -->
      <a href="/pelanggan"
        class="block mt-4 text-center bg-cyan-600 hover:bg-cyan-700 text-white py-3 rounded-lg">
        <i class="fas fa-arrow-left"></i> Kembali
      </a>

    </div>
  </div>

  <script>
    const form = document.getElementById('editForm');

    form.addEventListener('submit', (e) => {
      let valid = true;

      const nama = form.namapelanggan.value.trim();
      const alamat = form.alamat.value.trim();
      const telepon = form.nomortelepon.value.trim();

      document.querySelectorAll("p[id$='Error']").forEach(el => el.classList.add('hidden'));

      if (!nama) {
        document.getElementById('namaError').classList.remove('hidden');
        valid = false;
      }

      if (!alamat) {
        document.getElementById('alamatError').classList.remove('hidden');
        valid = false;
      }

      if (!telepon) {
        document.getElementById('teleponError').classList.remove('hidden');
        valid = false;
      }

      if (!valid) e.preventDefault();
    });
  </script>

</body>
</html>