<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Pelanggan</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

  <!-- WRAPPER -->
  <div class="min-h-screen flex items-center justify-center px-4">

    <!-- CARD -->
    <div class="w-full max-w-xl bg-white p-8 rounded-2xl shadow-xl">

      <!-- HEADER -->
      <div class="mb-8 text-center">
        <h2 class="text-2xl font-bold text-gray-800">
          Detail Pelanggan
        </h2>
      </div>

      <!-- DETAIL -->
      <div class="bg-gray-50 border rounded-xl p-6 space-y-5 text-base">

        <div class="flex justify-between border-b pb-3">
          <span class="font-semibold text-gray-600">ID</span>
          <span class="text-gray-800"><%= pelanggan.pelangganid %></span>
        </div>

        <div class="flex justify-between border-b pb-3">
          <span class="font-semibold text-gray-600">Nama</span>
          <span class="text-gray-800 text-right"><%= pelanggan.namapelanggan %></span>
        </div>

        <div class="flex justify-between border-b pb-3 items-start">
          <span class="font-semibold text-gray-600">Alamat</span>
          <span class="text-gray-800 text-right max-w-[65%] break-words">
            <%= pelanggan.alamat %>
          </span>
        </div>

        <div class="flex justify-between">
          <span class="font-semibold text-gray-600">Telepon</span>
          <span class="text-gray-800"><%= pelanggan.nomortelepon %></span>
        </div>

      </div>

      <!-- BUTTON -->
      <a href="/pelanggan"
        class="block mt-8 text-center bg-cyan-600 hover:bg-cyan-700 text-white py-3 rounded-lg text-base font-medium transition">
        <i class="fas fa-arrow-left"></i> Kembali
      </a>

    </div>
  </div>

</body>
</html>