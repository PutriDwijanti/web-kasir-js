<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Daftar Pelanggan</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-gray-100">

  <!-- CONTAINER -->
  <div class="max-w-6xl mx-auto px-4 py-10 md:py-14">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">
      
      <h1 class="text-2xl font-bold text-gray-700 text-center md:text-left">
        Daftar Pelanggan
      </h1>

      <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">

        <!-- SEARCH -->
        <input type="text" id="searchInput"
          placeholder="Cari nama atau alamat..."
          class="px-3 py-2 border rounded w-full sm:w-64">

        <!-- BUTTON -->
        <div class="flex gap-2">

          <a href="/pelanggan/create"
            class="flex-1 sm:flex-none text-center bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded flex items-center justify-center gap-2">
            <i class="fas fa-plus"></i> Tambah
          </a>

          <a href="/dashboard"
            class="flex-1 sm:flex-none text-center bg-cyan-500 hover:bg-cyan-600 text-white px-4 py-2 rounded flex items-center justify-center gap-2">
            <i class="fas fa-arrow-left"></i>
          </a>

        </div>
      </div>
    </div>

    <!-- TABLE -->
    <div class="bg-white shadow rounded-xl overflow-hidden">

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">

          <thead class="bg-blue-500 text-white text-center">
            <tr>
              <th class="p-3">ID</th>
              <th class="p-3">Nama</th>
              <th class="p-3">Alamat</th>
              <th class="p-3">Telepon</th>
              <th class="p-3">Aksi</th>
            </tr>
          </thead>

          <tbody id="pelangganTable" class="text-gray-700 text-center">
            <% pelanggan.forEach(p => { %>
              <tr class="border-b hover:bg-gray-100">

                <td class="p-2"><%= p.pelangganid %></td>
                <td class="p-2"><%= p.namapelanggan %></td>
                <td class="p-2 break-words max-w-[150px]"><%= p.alamat %></td>
                <td class="p-2"><%= p.nomortelepon %></td>

                <td class="p-2">
                  <div class="flex flex-wrap gap-1 justify-center">

                    <a href="/pelanggan/<%= p.pelangganid %>"
                      class="bg-cyan-500 hover:bg-cyan-600 text-white px-2 py-1 rounded text-xs">
                      <i class="fas fa-eye"></i>
                    </a>

                    <a href="/pelanggan/<%= p.pelangganid %>/edit"
                      class="bg-yellow-500 hover:bg-yellow-600 text-white px-2 py-1 rounded text-xs">
                      <i class="fas fa-edit"></i>
                    </a>

                    <form action="/pelanggan/<%= p.pelangganid %>?_method=DELETE" method="POST">
                      <button onclick="return confirmDelete()"
                        class="bg-red-500 hover:bg-red-600 text-white px-2 py-1 rounded text-xs">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>

                  </div>
                </td>

              </tr>
            <% }) %>
          </tbody>

        </table>
      </div>

    </div>

    <!-- PAGINATION -->
    <div class="flex justify-center items-center gap-3 mt-5">
      <button id="prevBtn" class="px-4 py-1 bg-gray-300 rounded hover:bg-gray-400">
        Prev
      </button>

      <span id="pageInfo" class="text-sm text-gray-600"></span>

      <button id="nextBtn" class="px-4 py-1 bg-gray-300 rounded hover:bg-gray-400">
        Next
      </button>
    </div>

  </div>

  <script>
    const rows = document.querySelectorAll('#pelangganTable tr');
    const rowsPerPage = 10;
    let currentPage = 1;

    function showPage(page) {
      const start = (page - 1) * rowsPerPage;
      const end = start + rowsPerPage;

      rows.forEach((row, index) => {
        row.style.display = (index >= start && index < end) ? '' : 'none';
      });

      document.getElementById('pageInfo').textContent =
        `Page ${page} / ${Math.ceil(rows.length / rowsPerPage)}`;
    }

    document.getElementById('prevBtn').addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        showPage(currentPage);
      }
    });

    document.getElementById('nextBtn').addEventListener('click', () => {
      if (currentPage < Math.ceil(rows.length / rowsPerPage)) {
        currentPage++;
        showPage(currentPage);
      }
    });

    // INIT
    showPage(currentPage);

    // SEARCH (tetap jalan)
    const searchInput = document.getElementById('searchInput');
    searchInput.addEventListener('input', () => {
      const filter = searchInput.value.toLowerCase();

      rows.forEach(row => {
        const nama = row.cells[1].textContent.toLowerCase();
        const alamat = row.cells[2].textContent.toLowerCase();
        row.style.display = (nama.includes(filter) || alamat.includes(filter)) ? '' : 'none';
      });
    });

    function confirmDelete() {
      return confirm('Yakin hapus data?');
    }
  </script>

</body>
</html>